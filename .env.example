# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required. Get it from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Optional. Without it the bot uses the rule-based analyzer and still works.
ANTHROPIC_API_KEY=

# Optional overrides.
# MOODBOT_MODEL=claude-opus-5
# MOODBOT_DB_PATH=moodbot.sqlite3
# MOODBOT_TIMEOUT_SECONDS=45
